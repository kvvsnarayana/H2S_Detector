# =============================================================
# Sulfide Sentinels - Environment Configuration
# =============================================================

# Database Provider Selection: 'sqlite' (offline local dev) or 'postgres' (shared cloud DB)
DB_PROVIDER=sqlite

# PostgreSQL Connection String (Required when DB_PROVIDER=postgres)
# Example Supabase / Neon connection string:
# DATABASE_URL=postgresql://postgres:your-password@db.xxx.supabase.co:5432/postgres
DATABASE_URL=

# Supabase Storage Configuration (Backend only - NEVER exposed to browser client)
# Pre-shift, post-shift & expiry images stored in 'scan-images' bucket
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Server Configuration
PORT=3000
NODE_ENV=development
